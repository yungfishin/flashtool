import json
import random
from datetime import datetime

# Danh sách kho dữ liệu mẫu hoặc từ khóa tự động mở rộng theo ngách hot
CATEGORIES = ['Đồ họa', 'Video Editor', 'Âm thanh', 'Lập trình', 'Tiện ích']

# Kho từ khóa/template phần mềm thực tế để bot tự động sinh nội dung chuẩn SEO
TOOL_TEMPLATES = [
    {"title": "Adobe Photoshop CC 2026 Full Crack", "desc": "Bộ công cụ chỉnh sửa ảnh và thiết kế đồ họa chuyên nghiệp hàng đầu thế giới."},
    {"title": "Premiere Pro 2026 Pre-Activated", "desc": "Phần mềm dựng phim, chỉnh sửa video chuyên nghiệp với AI hỗ trợ."},
    {"title": "After Effects 2026 Motion Graphics", "desc": "Tạo hiệu ứng kỹ xảo điện ảnh, đồ họa chuyển động và animation đỉnh cao."},
    {"title": "Lofi Chillhop Beats Sample Pack Vol.1", "desc": "Bộ sưu tập âm thanh, vòng lặp lofi beat bản quyền miễn phí cho nhà sáng tạo nội dung."},
    {"title": "VS Code Master Extension Pack 2026", "desc": "Gói extension tối ưu hóa tốc độ lập trình và code web cực nhanh."},
    {"title": "Figma Pro UI/UX Kit Template", "desc": "Bộ giao diện thiết kế ứng dụng di động và website hiện đại, tối ưu trải nghiệm."},
    {"title": "CapCut Pro Desktop Edition Full", "desc": "Ứng dụng cắt dựng video ngắn cực mượt trên máy tính cho TikTok và YouTube Shorts."},
    {"title": "Blender 3D Sci-Fi Assets Bundle", "desc": "Thư viện mô hình 3D không gian vũ trụ và công nghệ tương lai chất lượng cao."},
    {"title": "DaVinci Resolve Studio 2026", "desc": "Phần mềm dựng phim và chỉnh màu Hollywood chuyên nghiệp."},
    {"title": "Python Automation Scripts Collection", "desc": "Bộ mã nguồn tự động hóa công việc văn phòng, cào dữ liệu và quản lý tệp."}
]

def generate_massive_tools():
    tools = []
    current_date = datetime.now().strftime("%d/%m/%Y")
    
    # Lấy các template cơ bản
    for item in TOOL_TEMPLATES:
        tools.append({
            "title": item["title"],
            "description": item["desc"],
            "category": random.choice(CATEGORIES),
            "link": "https://github.com/yungfishin/flashtool/releases/download/v1.0.0/package.zip",
            "date": current_date
        })
    
    # Tự động nhân bản và sinh thêm biến thể để kho lúc nào cũng phong phú hàng chục/trăm tool
    extensions = ["Portable Edition", "Repack Pro", "Ultimate Pack", "Developer Edition", "Cloud Setup"]
    for i in range(1, 15):
        base = random.choice(TOOL_TEMPLATES)
        tools.append({
            "title": f"{base['title']} - {random.choice(extensions)} #{i}",
            "desc": f"{base['desc']} Phiên bản cập nhật tự động tối ưu hóa hiệu suất.",
            "category": random.choice(CATEGORIES),
            "link": "https://github.com/yungfishin/flashtool/releases/download/v1.0.0/package.zip",
            "date": current_date
        })
        
    return tools

if __name__ == "__main__":
    new_tools = generate_massive_tools()
    
    # Ghi đè hoặc cập nhật vào file tools.json
    with open("tools.json", "w", encoding="utf-8") as f:
        json.dump(new_tools, f, ensure_ascii=False, indent=4)
        
    print(f"Đã cập nhật thành công {len(new_tools)} phần mềm vào tools.json!")